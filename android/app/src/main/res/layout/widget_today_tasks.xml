<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Header (MS To Do style) -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left: Blue Check + Title + Dropdown chevron -->
        <LinearLayout
            android:id="@+id/widget_header_title_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_app_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_check_blue" />

            <TextView
                android:id="@+id/widget_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="My Day"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_dropdown_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_dropdown" />
        </LinearLayout>

        <!-- Right Action Icons: Refresh, Add (+), Settings (gear) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Refresh Button -->
            <ImageView
                android:id="@+id/widget_refresh_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Refresh"
                android:padding="6dp"
                android:src="@drawable/ic_widget_refresh" />

            <!-- Add Button -->
            <ImageView
                android:id="@+id/widget_add_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Add Task"
                android:padding="5dp"
                android:src="@drawable/ic_widget_add" />

            <!-- Settings / Overflow Button -->
            <ImageView
                android:id="@+id/widget_settings_btn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Settings"
                android:padding="6dp"
                android:src="@drawable/ic_widget_settings" />

        </LinearLayout>
    </LinearLayout>

    <!-- Subtle Hairline Header Divider -->
    <View
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:background="#1AFFFFFF" />

    <!-- Tasks ListView -->
    <ListView
        android:id="@+id/widget_task_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:footerDividersEnabled="false"
        android:headerDividersEnabled="false"
        android:scrollbars="none" />

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/widget_divider"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No tasks for today"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="+ Tap to add a task"
            android:textColor="#3B82F6"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
