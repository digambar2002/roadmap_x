<?xml version="1.0" encoding="utf-8"?>
<!-- Notification icons are referenced from Dart strings, not from code
     R8 can see, so resource shrinking must be told to keep them. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/*,@mipmap/ic_launcher,@mipmap/ic_launcher_round,@raw/keep" />
