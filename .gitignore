# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing credentials — never commit these
android/key.properties
android/app/*.jks
android/app/*.keystore

# Isar native library, downloaded on demand by tests
libisar.dylib
libisar*.so
isar.dll

# Supabase keys. The anon key is public by design and RLS is what protects the
# data, but this repository is public: committing it invites strangers to burn
# the project's free-tier signup and email quota. Copy
# dart_defines.example.json to dart_defines.json and fill it in locally.
dart_defines.json
